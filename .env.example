# Copy this file to .env and fill in the values below.
# .env is gitignored — never commit real secrets.

# --- PostgreSQL (used by both the postgres and app services in docker-compose.yaml) ---
POSTGRES_PASSWORD=change_me_locally

# --- App ---
# Must match POSTGRES_PASSWORD above when running via docker-compose.
DATABASE_URL=postgresql+psycopg://signalmap_user:change_me_locally@postgres:5432/signalmap

# Google Gemini API key (https://aistudio.google.com/apikey). Required to
# actually trigger a run — the app starts without it, but run attempts fail.
GOOGLE_API_KEY=

# Anthropic Claude API key (https://console.anthropic.com/settings/keys).
# Required to trigger a run against a Claude model — the app starts without
# it, but run attempts fail.
ANTHROPIC_API_KEY=

# JWT signing key for the login session cookie. Required — the app fails to start without it
# (never a silent weak default for something security-critical). Generate a random value per
# environment, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"` — never
# reuse the same value across dev/staging/production, and never commit the real value.
SECRET_KEY=

# Keep false for local dev (plain HTTP) — a Secure cookie is never sent by a real browser over
# HTTP, so logins would silently "not stick". Set to true once the app is served over HTTPS
# (docs/ROADMAP.md §2), or the login cookie won't get the Secure flag it needs in production.
COOKIE_SECURE=false
