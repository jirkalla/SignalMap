# Copy to .env; never commit real secrets. See README.md for setup.
# Required: generate each separately with `openssl rand -hex 32`.
# Use a hex database password because Compose embeds it in DATABASE_URL.
POSTGRES_PASSWORD=
SECRET_KEY=

# Local defaults. On Hetzner, change these six values as shown in README.md.
SITE_ADDRESS=:80
BIND_ADDRESS=127.0.0.1
HTTP_PORT=58000
HTTPS_PORT=58443
COOKIE_SECURE=false
ENVIRONMENT=development

# Optional: the app and login work without API keys; provider runs need one.
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional local bootstrap, used only by scripts.create_admin --from-env.
# On Hetzner, leave these empty and use the interactive create_admin command.
DEV_ADMIN_EMAIL=
DEV_ADMIN_NAME=
DEV_ADMIN_PASSWORD=
